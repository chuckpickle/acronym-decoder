{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/",
    "sourceMap": true,
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "module": "es2022",
    "jsx": "react",
    "allowJs": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "types": [
      "chrome"
    ],
    "lib": [
      "es2022",
      "dom"
    ]
  },
  "exclude": [
    "e2e",
    "node_modules",
    "dist"
  ]
}
