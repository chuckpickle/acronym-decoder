{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "es2020",
      "dom",
      "dom.iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmit": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "types": [
      "chrome",
      "vitest/globals",
      "node"
    ],
    "strictPropertyInitialization": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "content-script/**/*.ts",
    "vite.config.mts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "src/test.ts",
    "src/testing/spec-helpers.ts",
    "src/app/**/*.component.ts",
    "src/app/**/*.module.ts",
    "src/app/custom-modules/**"
  ]
}
