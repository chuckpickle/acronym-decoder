{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/",
    "sourceMap": true,
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "module": "es6",
    "jsx": "react",
    "allowJs": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "types": [
      "chrome",
      "jasmine",
      "jasminewd2",
      "node"
    ]
  }
}
